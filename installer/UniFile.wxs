<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="UniFile"
      Manufacturer="SysAdminDoc"
      Version="$(var.ProductVersion)"
      UpgradeCode="4B6E6A1C-3C49-4F65-8A40-5FD0F7A1C2D8"
      Scope="perMachine"
      Compressed="yes">
    <SummaryInformation
        Description="UniFile unified AI-powered file organizer"
        Manufacturer="SysAdminDoc" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of UniFile is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPPRODUCTICON" Value="UniFileIcon" />

    <Feature Id="MainFeature" Title="UniFile" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentRef Id="ApplicationExecutable" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="UniFile" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="UniFile" />
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.BuildOutput)\**">
        <Exclude Files="$(var.BuildOutput)\UniFile.exe" />
        <Exclude Files="$(var.BuildOutput)\UniFile.exe.sha256" />
      </Files>
    </ComponentGroup>

    <Component Id="ApplicationExecutable" Directory="INSTALLFOLDER" Guid="*">
      <File Id="UniFileExecutable" Source="$(var.BuildOutput)\UniFile.exe" KeyPath="yes" />

      <Environment
          Id="AddUniFileToUserPath"
          Name="PATH"
          Value="[INSTALLFOLDER]"
          Permanent="no"
          Part="last"
          Action="set"
          System="yes" />

      <RegistryKey Root="HKCR" Key=".unifile">
        <RegistryValue Type="string" Value="UniFile.Library" />
      </RegistryKey>
      <RegistryKey Root="HKCR" Key="UniFile.Library">
        <RegistryValue Type="string" Value="UniFile library" />
      </RegistryKey>
      <RegistryKey Root="HKCR" Key="UniFile.Library\DefaultIcon">
        <RegistryValue Type="string" Value="[#UniFileExecutable],0" />
      </RegistryKey>
      <RegistryKey Root="HKCR" Key="UniFile.Library\shell\open\command">
        <RegistryValue
            Type="string"
            Value="&quot;[#UniFileExecutable]&quot; &quot;%1&quot;" />
      </RegistryKey>

      <RegistryKey Root="HKCR" Key="Directory\shell\UniFile">
        <RegistryValue Type="string" Value="Organize with UniFile" />
        <RegistryValue Name="Icon" Type="string" Value="[#UniFileExecutable],0" />
      </RegistryKey>
      <RegistryKey Root="HKCR" Key="Directory\shell\UniFile\command">
        <RegistryValue
            Type="string"
            Value="&quot;[#UniFileExecutable]&quot; --source &quot;%1&quot; --show-preview" />
      </RegistryKey>
      <RegistryKey Root="HKCR" Key="Directory\Background\shell\UniFile">
        <RegistryValue Type="string" Value="Organize with UniFile" />
        <RegistryValue Name="Icon" Type="string" Value="[#UniFileExecutable],0" />
      </RegistryKey>
      <RegistryKey Root="HKCR" Key="Directory\Background\shell\UniFile\command">
        <RegistryValue
            Type="string"
            Value="&quot;[#UniFileExecutable]&quot; --source &quot;%V&quot; --show-preview" />
      </RegistryKey>
    </Component>

    <Component Id="ApplicationShortcut" Directory="ApplicationProgramsFolder" Guid="*">
      <Shortcut
          Id="UniFileStartMenuShortcut"
          Name="UniFile"
          Description="Launch UniFile"
          Target="[INSTALLFOLDER]UniFile.exe"
          WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveUniFileStartMenuFolder" On="uninstall" />
      <RegistryValue
          Root="HKCU"
          Key="Software\SysAdminDoc\UniFile"
          Name="Installed"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>
  </Fragment>

  <Fragment>
    <Icon Id="UniFileIcon" SourceFile="$(var.ProjectRoot)\icon.ico" />
  </Fragment>
</Wix>
